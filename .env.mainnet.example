# Deployment: server needs only the network, recipient and price below.
ARC_NETWORK=mainnet
PUBLIC_BASE_URL=https://your-radar-agent-deployment.example
SELLER_ADDRESS=0xYourMainnetSellerAddress
SIGNAL_PRICE_USDC=0.001
RADAR_ALLOW_DEMO_SIGNALS=false

# Buyer runs locally. Never put buyer keys or Circle secrets on the seller host.
BUYER_ADDRESS=0xYourApprovedMainnetTestWallet
BUYER_PRIVATE_KEY=0xYourDedicatedMainnetBuyerPrivateKey
BASE_URL=https://your-radar-agent-deployment.example
SIGNAL_MAX_PRICE_USDC=0.001
DATA_DAILY_CAP_USDC=0.01
TREASURY_DAILY_CAP_USDC=0

# No deposits or treasury transfers by default.
GATEWAY_AUTO_DEPOSIT_USDC=0
GATEWAY_MAX_DEPOSIT_USDC=0.01

# Optional durable volume on a self-hosted server. Serverless filesystem logs
# are ephemeral; retain the buyer audit locally for the grant evidence.
# PAYMENT_AUDIT_PATH=/data/radar-payments.jsonl
