# Default to testnet. Buyer and seller must use the same profile.
ARC_NETWORK=testnet
# Optional canonical origin; set this to the HTTPS URL on the seller host.
# PUBLIC_BASE_URL=http://localhost:3000
# ARC_RPC_URL can override the profile's official RPC endpoint.

# Seller: the EVM address that receives x402 nanopayments.
SELLER_ADDRESS=0xYourSellerWalletAddress
SIGNAL_PRICE_USDC=0.001

# Buyer: a testnet-only EVM private key. Fund its Gateway balance before paying.
BUYER_PRIVATE_KEY=0xYourBuyerPrivateKey
BASE_URL=http://localhost:3000
GATEWAY_AUTO_DEPOSIT_USDC=1
# Applies to mainnet deposits, which also need --allow-deposit.
GATEWAY_MAX_DEPOSIT_USDC=0.01
SIGNAL_MAX_PRICE_USDC=0.001

# Deterministic agent safety limits.
DATA_DAILY_CAP_USDC=0.10
TREASURY_DAILY_CAP_USDC=25
TREASURY_REBALANCE_USDC=1
TREASURY_MIN_REMAINING_USDC=5
TREASURY_AVAILABLE_USDC=10

# Circle App Kit + developer-controlled wallet treasury execution.
CIRCLE_API_KEY=your-circle-api-key
CIRCLE_ENTITY_SECRET=your-circle-entity-secret
CIRCLE_WALLET_ADDRESS=0xYourActiveTreasuryWallet
RESERVE_WALLET_ADDRESS=0xYourReserveWallet

# Reliable judged demos may request ?demo=sharp_drop while still paying over x402.
RADAR_ALLOW_DEMO_SIGNALS=false

# Optional append-only seller payment log. Useful locally; serverless disks are ephemeral.
PAYMENT_AUDIT_PATH=seller/state/payments.jsonl

# Optional override. Default state is separated by mainnet/testnet/dry-run.
# RADAR_STATE_DIR=agent/state/testnet
